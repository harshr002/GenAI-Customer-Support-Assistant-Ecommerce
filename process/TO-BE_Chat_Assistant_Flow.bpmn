<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
  xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
  xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
  xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
  id="Definitions_1" targetNamespace="http://bpmn.io/schema/bpmn" exporter="bpmn_gen.py" exporterVersion="1.0">
<bpmn:collaboration id="Collaboration_1">
<bpmn:participant id="Participant_1" name="E-commerce Customer Support (Pilot)" processRef="Process_1"/>
</bpmn:collaboration>
<bpmn:process id="Process_1" name="TO-BE: GenAI support assistant conversation flow with human handoff" isExecutable="false">
<bpmn:laneSet id="LaneSet_1">
<bpmn:lane id="L_c" name="Customer"><bpmn:flowNodeRef>s1</bpmn:flowNodeRef><bpmn:flowNodeRef>c1</bpmn:flowNodeRef><bpmn:flowNodeRef>c2</bpmn:flowNodeRef><bpmn:flowNodeRef>g4</bpmn:flowNodeRef><bpmn:flowNodeRef>e1</bpmn:flowNodeRef></bpmn:lane>
<bpmn:lane id="L_ai" name="AI Assistant"><bpmn:flowNodeRef>a1</bpmn:flowNodeRef><bpmn:flowNodeRef>g1</bpmn:flowNodeRef><bpmn:flowNodeRef>g2</bpmn:flowNodeRef><bpmn:flowNodeRef>a2</bpmn:flowNodeRef><bpmn:flowNodeRef>a3</bpmn:flowNodeRef><bpmn:flowNodeRef>g3</bpmn:flowNodeRef></bpmn:lane>
<bpmn:lane id="L_sys" name="Order &amp; Returns Systems"><bpmn:flowNodeRef>o1</bpmn:flowNodeRef></bpmn:lane>
<bpmn:lane id="L_ag" name="Support Agent"><bpmn:flowNodeRef>h1</bpmn:flowNodeRef><bpmn:flowNodeRef>h2</bpmn:flowNodeRef><bpmn:flowNodeRef>e2</bpmn:flowNodeRef></bpmn:lane>
</bpmn:laneSet>
<bpmn:startEvent id="s1" name="Opens web chat"><bpmn:outgoing>Flow_1</bpmn:outgoing></bpmn:startEvent>
<bpmn:userTask id="c1" name="Asks question"><bpmn:incoming>Flow_1</bpmn:incoming><bpmn:incoming>Flow_15</bpmn:incoming><bpmn:outgoing>Flow_2</bpmn:outgoing></bpmn:userTask>
<bpmn:serviceTask id="a1" name="Detect intent, sentiment and handoff triggers"><bpmn:incoming>Flow_2</bpmn:incoming><bpmn:outgoing>Flow_3</bpmn:outgoing></bpmn:serviceTask>
<bpmn:exclusiveGateway id="g1" name="Handoff trigger hit?"><bpmn:incoming>Flow_3</bpmn:incoming><bpmn:outgoing>Flow_4</bpmn:outgoing><bpmn:outgoing>Flow_5</bpmn:outgoing></bpmn:exclusiveGateway>
<bpmn:exclusiveGateway id="g2" name="Needs order data?"><bpmn:incoming>Flow_5</bpmn:incoming><bpmn:outgoing>Flow_6</bpmn:outgoing><bpmn:outgoing>Flow_9</bpmn:outgoing></bpmn:exclusiveGateway>
<bpmn:serviceTask id="a2" name="Verify customer with OTP"><bpmn:incoming>Flow_6</bpmn:incoming><bpmn:outgoing>Flow_7</bpmn:outgoing></bpmn:serviceTask>
<bpmn:serviceTask id="o1" name="Return order, return or refund status"><bpmn:incoming>Flow_7</bpmn:incoming><bpmn:outgoing>Flow_8</bpmn:outgoing></bpmn:serviceTask>
<bpmn:serviceTask id="a3" name="Draft answer only from knowledge base and order data"><bpmn:incoming>Flow_8</bpmn:incoming><bpmn:incoming>Flow_9</bpmn:incoming><bpmn:outgoing>Flow_10</bpmn:outgoing></bpmn:serviceTask>
<bpmn:exclusiveGateway id="g3" name="Confidence at least 0.75?"><bpmn:incoming>Flow_10</bpmn:incoming><bpmn:outgoing>Flow_11</bpmn:outgoing><bpmn:outgoing>Flow_12</bpmn:outgoing></bpmn:exclusiveGateway>
<bpmn:userTask id="c2" name="Reads answer with policy link"><bpmn:incoming>Flow_11</bpmn:incoming><bpmn:outgoing>Flow_13</bpmn:outgoing></bpmn:userTask>
<bpmn:exclusiveGateway id="g4" name="Resolved?"><bpmn:incoming>Flow_13</bpmn:incoming><bpmn:outgoing>Flow_14</bpmn:outgoing><bpmn:outgoing>Flow_15</bpmn:outgoing></bpmn:exclusiveGateway>
<bpmn:endEvent id="e1" name="Chat closed, CSAT survey sent"><bpmn:incoming>Flow_14</bpmn:incoming></bpmn:endEvent>
<bpmn:userTask id="h1" name="Take over chat with transcript and AI summary"><bpmn:incoming>Flow_4</bpmn:incoming><bpmn:incoming>Flow_12</bpmn:incoming><bpmn:outgoing>Flow_16</bpmn:outgoing></bpmn:userTask>
<bpmn:userTask id="h2" name="Resolve and tag reason for handoff"><bpmn:incoming>Flow_16</bpmn:incoming><bpmn:outgoing>Flow_17</bpmn:outgoing></bpmn:userTask>
<bpmn:endEvent id="e2" name="Resolved by agent, CSAT survey sent"><bpmn:incoming>Flow_17</bpmn:incoming></bpmn:endEvent>
<bpmn:sequenceFlow id="Flow_1" sourceRef="s1" targetRef="c1"/>
<bpmn:sequenceFlow id="Flow_2" sourceRef="c1" targetRef="a1"/>
<bpmn:sequenceFlow id="Flow_3" sourceRef="a1" targetRef="g1"/>
<bpmn:sequenceFlow id="Flow_4" name="Yes" sourceRef="g1" targetRef="h1"/>
<bpmn:sequenceFlow id="Flow_5" name="No" sourceRef="g1" targetRef="g2"/>
<bpmn:sequenceFlow id="Flow_6" name="Yes" sourceRef="g2" targetRef="a2"/>
<bpmn:sequenceFlow id="Flow_7" sourceRef="a2" targetRef="o1"/>
<bpmn:sequenceFlow id="Flow_8" sourceRef="o1" targetRef="a3"/>
<bpmn:sequenceFlow id="Flow_9" name="No" sourceRef="g2" targetRef="a3"/>
<bpmn:sequenceFlow id="Flow_10" sourceRef="a3" targetRef="g3"/>
<bpmn:sequenceFlow id="Flow_11" name="Yes" sourceRef="g3" targetRef="c2"/>
<bpmn:sequenceFlow id="Flow_12" name="No" sourceRef="g3" targetRef="h1"/>
<bpmn:sequenceFlow id="Flow_13" sourceRef="c2" targetRef="g4"/>
<bpmn:sequenceFlow id="Flow_14" name="Yes" sourceRef="g4" targetRef="e1"/>
<bpmn:sequenceFlow id="Flow_15" name="No" sourceRef="g4" targetRef="c1"/>
<bpmn:sequenceFlow id="Flow_16" sourceRef="h1" targetRef="h2"/>
<bpmn:sequenceFlow id="Flow_17" sourceRef="h2" targetRef="e2"/>
</bpmn:process>
